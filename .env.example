# Bearer token required as `Authorization: Bearer <token>` on every /mcp request.
WORKSPACE_MCP_TOKEN=

# OAuth client credentials and refresh token used for Gmail, Calendar and Tasks.
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional: token endpoint, defaults to https://oauth2.googleapis.com/token
# GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
