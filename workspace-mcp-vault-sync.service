[Unit]
Description=Sync the workspace-mcp app .env from Vault
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=WORKSPACE_MCP_VAULT_ADDR=http://127.0.0.1:8200
ExecStart=/usr/local/bin/workspace-mcp-vault-sync.sh
SuccessExitStatus=0 1
